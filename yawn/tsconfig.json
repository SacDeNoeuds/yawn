{
  "include": ["./src"],
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "declaration": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "ES2018.AsyncIterable", "ESNext.AsyncIterable"]
  }
}