{
  "name": "@sacdenoeuds/yawn",
  "version": "0.1.0",
  "description": "The JSX library to embrace JavaScript fatigue",
  "license": "MIT",
  "author": "SacDeNoeuds <sacdenoeuds.dev@gmail.com>",
  "repository": {
    "url": "https://github.com/SacDeNoeuds/yawn"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./jsx/jsx-runtime": {
      "import": "./dist/jsx/jsx-runtime.js",
      "types": "./dist/jsx/jsx-runtime.d.ts"
    },
    "./jsx/jsx-dev-runtime": {
      "import": "./dist/jsx/jsx-dev-runtime.js",
      "types": "./dist/jsx/jsx-dev-runtime.d.ts"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "rollup -c",
    "check-ts": "tsc -P tsconfig.json",
    "test": "vitest",
    "test:mutation": "stryker run",
    "test:coverage": "vitest --coverage",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "rollup": "^4.59.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
