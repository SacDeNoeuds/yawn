{
  "name": "@sacdenoeuds/yawn",
  "version": "0.1.0",
  "description": "The JSX library to embrace JavaScript fatigue",
  "license": "MIT",
  "author": "SacDeNoeuds <sacdenoeuds.dev@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "url": "https://github.com/SacDeNoeuds/yawn"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./jsx/jsx-runtime": {
      "import": "./dist/jsx/jsx-runtime.js",
      "types": "./dist/jsx/jsx-runtime.d.ts"
    },
    "./jsx/jsx-dev-runtime": {
      "import": "./dist/jsx/jsx-dev-runtime.js",
      "types": "./dist/jsx/jsx-dev-runtime.d.ts"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "rollup -c",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.59.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tslib": "^2.8.1"
  }
}
