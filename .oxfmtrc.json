{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "objectWrap": "preserve",
  "singleAttributePerLine": false,
  "overrides": [
    {
      "files": ["*.spec.ts"],
      "options": {
        "printWidth": 120
      }
    }
  ]
}
